# Servidor solamente. Usar el destino Neon actual; nunca una variable EXPO_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_TIMEOUT_MS=5000
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Sync requiere secretKey para metadata servidor; JWT_KEY sólo sustituye la verificación.
# Clave PEM pública opcional de Clerk, nunca la privada.
# CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:8081
API_ALLOWED_ORIGINS=http://localhost:8081
